# ------------------------------------------------------------------
# Oakbridge Publishing — backend environment TEMPLATE
# Copy to `.env` and fill in values:  cp .env.example .env
# ------------------------------------------------------------------

# --- Required: database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=oakbridge

# --- Required: auth (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Required: CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Seeded admin account (created on first startup) ---
ADMIN_EMAIL=admin@oakbridge.in
ADMIN_PASSWORD=change-me

# --- Optional: Razorpay payments (blank => /api/payments/* return 503) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional: Resend email (blank => emails skipped) ---
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
SENDER_NAME=Oakbridge Publishing
ADMIN_NOTIFY_EMAIL=

# --- Cart-reminders cron auth (any long random string) ---
TASK_TOKEN=

# --- AI (author-bio drafting) — OpenAI-compatible, provider-agnostic ---
# Default = local Ollama (free & open-source): install Ollama, `ollama pull llama3.1`, restart.
# Or a free cloud tier, e.g. Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant
#   LLM_API_KEY=gsk_your_free_key
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# --- File storage (local disk) ---
# Uploaded covers / eBooks / media are stored here and served at /api/files/{path}.
# Leave unset to use backend/storage. On Render, point this at a persistent disk.
STORAGE_DIR=
