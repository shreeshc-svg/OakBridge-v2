# Oakbridge Publishing — frontend environment TEMPLATE
# Copy to `.env`:  cp .env.example .env
# NOTE: CRA bakes this in at build time. Rebuild after changes.

# Base URL of the FastAPI backend (no trailing slash).
#   Local dev:   http://localhost:8000
#   Production:  set REACT_APP_BACKEND_URL in the Vercel dashboard (Project ->
#                Settings -> Environment Variables), NOT in this file.
#                Pre-cutover value:  https://oakbridge-v2.onrender.com
#                At domain cutover:  https://api.oakbridge.in   (then redeploy)
REACT_APP_BACKEND_URL=http://localhost:8000
