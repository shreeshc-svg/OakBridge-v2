{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/sanity-check.js && bash scripts/vercel-chrome-deps.sh && npx --yes puppeteer browsers install chrome && yarn build:seo",
  "outputDirectory": "build",
  "build": {
    "env": {
      "BACKEND_URL": "https://api.oakbridge.in",
      "PRERENDER_CONCURRENCY": "4"
    }
  },
  "redirects": [
    {
      "source": "/book/:slug*",
      "destination": "/books",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.oakbridge.in/api/sitemap.xml" },
    { "source": "/.well-known/:path*", "destination": "https://api.oakbridge.in/api/.well-known/:path*" },
    { "source": "/(.*)", "destination": "/app-shell.html" }
  ]
}
