{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/sanity-check.js && yarn build",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/book/:slug*",
      "destination": "/books",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.oakbridge.in/api/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
